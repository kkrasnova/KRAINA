#!/bin/sh
# Remove IDE / AI branding from commit messages before commit completes.
msgfile="$1"
[ -z "$msgfile" ] || [ ! -f "$msgfile" ] && exit 0
if grep -qiE 'Made-with|Made with |Powered by |Co-authored-by:.*(Cursor|Claude|Anthropic|cursoragent)' "$msgfile" 2>/dev/null; then
  if sed --version >/dev/null 2>&1; then
    sed -i \
      -e '/Made-with/d' \
      -e '/Made with /d' \
      -e '/Powered by /d' \
      -e '/^Co-authored-by:.*Cursor/d' \
      -e '/^Co-authored-by:.*Claude/d' \
      -e '/^Co-authored-by:.*[Aa]nthropic/d' \
      -e '/^Co-authored-by:.*cursoragent/d' \
      "$msgfile"
  else
    sed -i '' \
      -e '/Made-with/d' \
      -e '/Made with /d' \
      -e '/Powered by /d' \
      -e '/^Co-authored-by:.*Cursor/d' \
      -e '/^Co-authored-by:.*Claude/d' \
      -e '/^Co-authored-by:.*[Aa]nthropic/d' \
      -e '/^Co-authored-by:.*cursoragent/d' \
      "$msgfile"
  fi
fi
exit 0
