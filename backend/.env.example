NODE_ENV=development
PORT=3000
# Локальна Postgres (docker-compose.yml): з кореня репо `npm run db:up`, потім `npm run db:migrate`
# На macOS використовуйте 127.0.0.1, не localhost — Node часто підключається до IPv6 (::1), контейнер слухає IPv4.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/kraina
# Для managed Postgres (Supabase/Neon/Railway/Render): зазвичай потрібен SSL
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=false
# (або PGSSLMODE=require)
JWT_SECRET=change-me-min-32-chars-for-hs256-secret-key
REFRESH_SECRET=change-me-refresh-pepper-for-token-hash
GOOGLE_CLIENT_ID=58561963441-pnnvj45vfinrjbo7ouifojmts1u19r49.apps.googleusercontent.com
APPLE_CLIENT_ID=com.kraina.app
APPLE_TEAM_ID=
APPLE_KEY_ID=
PUBLIC_BASE_URL=http://localhost:3000

# --- Версія застосунку (публічно GET /api/app/version) ---
# Якщо задати MIN_SUPPORTED_APP_VERSION вище за встановлену в клієнті — показується екран оновлення.
MIN_SUPPORTED_APP_VERSION=
IOS_APP_STORE_URL=
ANDROID_PLAY_STORE_URL=
# Для веб-клієнта: через кому. У production без списку браузерні запити з Origin будуть відхилені (RN/curl без Origin — ок).
CORS_ORIGINS=
# --- Firebase Admin SDK (спільний модуль services/firebaseAdmin.ts) ---
# Потрібен для:
#   - Firebase custom tokens (POST /api/auth/register, /login, /google, /apple, /refresh)
#   - Firestore верифікація follow-запитів (POST /api/social/follow)
#   - Публікація landmark-контенту в Firestore (npm run migrate:firestore, /api/admin/landmark-content/publish)
#
# На Render: використовуйте FIREBASE_SERVICE_ACCOUNT_JSON (inline).
# FIREBASE_SERVICE_ACCOUNT_PATH не підходить, бо файл не збережеться між редеплоями.
#
# Як отримати JSON ключ:
#   Firebase Console → Project settings → Service accounts →
#   Firebase Admin SDK → Generate new private key
#
# Екранування для Render Dashboard (вставити як один рядок):
#   cat your-project-firebase-adminsdk-xxxxx.json | python3 -c 'import sys,json; print(json.dumps(json.load(sys.stdin)))'
# Скопіюйте виведений рядок і вставте в FIREBASE_SERVICE_ACCOUNT_JSON на Render Dashboard.
#
# FIREBASE_SERVICE_ACCOUNT_PATH не використовуйте на Render — тільки локально для dev.
# FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/your-project-firebase-adminsdk-xxxxx.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...",...}
# FIRESTORE_DATABASE_ID=(default)
# За reverse proxy (nginx): 1 або true — для коректного req.ip і rate limit
TRUST_PROXY=
UPLOAD_DIR=./uploads
MAX_AVATAR_BYTES=5242880
# Веб-адмінка /landmarks-cms: JSON бандл + фото. Публічне читання для додатка:
# GET /api/app/landmark-content/bundle  (0 = вимкнути)
# LANDMARK_BUNDLE_PUBLIC_GET=0
# MAX_LANDMARK_BUNDLE_BYTES=15728640
# MAX_LANDMARK_MEDIA_BYTES=12582912

# --- ШІ-маршрути (OpenAI або сумісний API; Groq: OPENAI_BASE_URL=https://api.groq.com/openai/v1) ---
# Без OPENAI_API_KEY сервер усе одно поверне маршрут (жадібний порядок по каталогу).
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_ROUTE_MODEL=gpt-4o-mini

# --- LiveKit (аудіо- та відеодзвінки) ---
# Отримайте на cloud.livekit.io → Settings → Keys
# LIVEKIT_URL=wss://<project>.livekit.cloud
# LIVEKIT_API_KEY=API...
# LIVEKIT_API_SECRET=...

# --- APNs (VoIP push для вхідних дзвінків) ---
# Apple Developer → Certificates → VoIP Services Certificate → .p8 ключ
# Якщо задати APNS_PRODUCTION=1, push підуть на production APNs, інакше — sandbox.
# У production на Render: APNS_KEY (inline) або APNS_KEY_PATH.
# APNS_KEY_ID=XXXXXXXXXX
# APNS_TEAM_ID=XXXXXXXXXX
# APNS_TOPIC=com.kraina.app
# APNS_PRODUCTION=0
# APNS_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# --- Billing: POST /api/billing/verify (опційно; без них верифікація поверне 503) ---
# Apple App Store shared secret (Subscriptions у App Store Connect)
APPLE_IAP_SHARED_SECRET=
# SKU через кому, узгоджені з EXPO_PUBLIC_IAP_*_IOS у застосунку
IAP_APPLE_SKU_EXPLORER=
IAP_APPLE_SKU_PRO=
IAP_APPLE_SKU_FAMILY=
# Google Play: package name + service account JSON (одним рядком) + SKU через кому
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
IAP_GOOGLE_SKU_EXPLORER=
IAP_GOOGLE_SKU_PRO=
IAP_GOOGLE_SKU_FAMILY=
