diff --git a/node_modules/expo/android/build/intermediates/merged_res/release/mergeReleaseResources/color/m3_chip_ripple_color.xml b/node_modules/expo/android/build/intermediates/merged_res/release/mergeReleaseResources/color/m3_chip_ripple_color.xml
