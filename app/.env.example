# =============================================================================
# Resend — листи з 6-значним кодом (відновлення пароля в додатку)
# =============================================================================
# 1) Скопіюйте в app/.env:
#      cd app && cp .env.example .env
# 2) У Resend (https://resend.com): Sign up → API Keys → Create → вставте ключ у рядок нижче.
#    Формат ключа: re_... (не UUID з іншого сервісу).
# 3) Без лапок і пробілів навколо =. Один рядок = одна змінна.
# 4) Після змін у .env завжди перезапускайте Metro з очищенням кешу:
#      cd app && npm run start:clear
#    (babel-preset-expo підставляє EXPO_PUBLIC_* з process.env на етапі збірки.)
#
# Режими Resend:
# • Без верифікованого домену: можна слати лише на e-mail, яким ви зайшли в resend.com
#   (або на тестові адреси за правилами Resend).
# • З верифікованим доменом: додайте домен у Resend → Domains, потім розкоментуйте
#   EXPO_PUBLIC_RESEND_FROM з адресою на цьому домені.

EXPO_PUBLIC_RESEND_API_KEY=re_your_key_here

# Після верифікації домену (обов’язково для продакшену на довільні пошти):
# EXPO_PUBLIC_RESEND_FROM=KRAÏNA <noreply@your-verified-domain.com>
#
# Лист з кодом — білий шаблон з текстовим логотипом KRAÏNA (іконка в листі не потрібна).

# =============================================================================
# Firebase Runtime Config (основне джерело істини для app runtime)
# =============================================================================
# Значення з Firebase Console → Project settings → Your apps (Web app config).
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
EXPO_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Cloud Functions base URL (опційно, якщо потрібні callable/HTTP функції)
# EXPO_PUBLIC_FIREBASE_FUNCTIONS_URL=https://us-central1-your-project.cloudfunctions.net

# Legacy backend URL лишається лише для read-only rollback періоду, не як runtime source of truth.
# EXPO_PUBLIC_KRAINA_API_URL=http://localhost:3000

# =============================================================================
# Firebase / Google (файли з консолі Firebase — не комітити, лише локально)
# =============================================================================
# 1) Завантаж google-services.json (Android) і GoogleService-Info.plist (iOS) з Firebase.
# 2) Поклади їх у:
#      app/google-services.json
#      app/ios/KRANA/GoogleService-Info.plist
#    (за потреби дубль app/GoogleService-Info.plist — з того ж файлу з консолі)
# 3) Скопіюй google-ios-client.example.json → google-ios-client.json і встав iosClientId з plist (CLIENT_ID).
# 4) npm run google:ios-scheme — оновить URL scheme для Google Sign-In.
# Шаблони без секретів: google-services.json.example, ios/KRANA/GoogleService-Info.plist.example

# =============================================================================
# Інше (опційно)
# =============================================================================
# EXPO_PUBLIC_GOOGLE_CLIENT_ID=...
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=...

# =============================================================================
# Facebook Login (Meta Developers → App ID + Valid OAuth Redirect URIs)
# =============================================================================
# Без EXPO_PUBLIC_FACEBOOK_APP_ID кнопка Facebook на екрані входу прихована.
# У Meta Console → Facebook Login → Settings додай redirect:
#   com.kraina.app://oauth
# Для Expo Go (тимчасово): exp://127.0.0.1:8081/--/oauth або ваш LAN exp://…
# EXPO_PUBLIC_FACEBOOK_APP_ID=your-meta-app-id
# EXPO_PUBLIC_FACEBOOK_REDIRECT_URI=com.kraina.app://oauth
# Maps SDK (Android manifest + Directions/Geocoding у JS). Обмеж ключ у GCP за package com.kraina.app + SHA-1.
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-maps-key
# Після зміни ключа: перезберіть Android (npm run android), Metro можна лише перезапустити для JS.
# Після зміни iOS CLIENT_ID: npm run google:ios-scheme

# =============================================================================
# Маркетинговий сайт (екрани «Допомога» та «Інформація»)
# =============================================================================
# Якщо не задано, підставляються extra.krainaSiteUrl / helpFaqUrl / helpDocsUrl з app.json
# (типово — https://kraina-207c5.web.app).
# EXPO_PUBLIC_KRAINA_WEBSITE_URL=https://kraina-207c5.web.app
# EXPO_PUBLIC_KRAINA_SITE_URL=https://kraina-207c5.web.app
# EXPO_PUBLIC_HELP_FAQ_URL=https://kraina.world/#faq
# EXPO_PUBLIC_HELP_DOCS_URL=https://kraina.world/#guide
# EXPO_PUBLIC_HELP_DOCS_URL=https://example.com/docs

# =============================================================================
# Оновлення з магазину (екран «Потрібне оновлення», якщо бекенд вимагає новішу версію)
# =============================================================================
# Посилання на сторінку застосунку в App Store / Google Play (якщо бекенд не поверне ios_store_url / android_store_url).
# Також використовуються як резерв для FAQ/доків, якщо немає HELP_* URL.
# EXPO_PUBLIC_IOS_APP_STORE_URL=https://apps.apple.com/app/id0000000000
# EXPO_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.kraina.app
