require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")
require File.join(File.dirname(`node --print "require.resolve('react-native/package.json')"`), "scripts/react_native_pods")

require 'json'
podfile_properties = JSON.parse(File.read(File.join(__dir__, 'Podfile.properties.json'))) rescue {}

def verify_ccache_installed(pp)
  return unless ENV['USE_CCACHE'] == '1' || pp['apple.ccacheEnabled'] == 'true'
  ccache_path = `which ccache 2>/dev/null`.strip
  if ccache_path.empty?
    puts "⚠️  ccache is enabled in Podfile.properties.json but not installed."
    puts "   Install it: brew install ccache"
    puts "   Or disable: set apple.ccacheEnabled to false in Podfile.properties.json"
  else
    puts "✅ ccache found at #{ccache_path}"
  end
end

def ccache_enabled?(podfile_properties)
  # Environment variable takes precedence
  return ENV['USE_CCACHE'] == '1' if ENV['USE_CCACHE']
  
  # Fall back to Podfile properties
  podfile_properties['apple.ccacheEnabled'] == 'true'
end

ENV['RCT_NEW_ARCH_ENABLED'] ||= '0' if podfile_properties['newArchEnabled'] == 'false'
ENV['EX_DEV_CLIENT_NETWORK_INSPECTOR'] ||= podfile_properties['EX_DEV_CLIENT_NETWORK_INSPECTOR']
ENV['RCT_USE_RN_DEP'] ||= '1' if podfile_properties['ios.buildReactNativeFromSource'] != 'true' && podfile_properties['newArchEnabled'] != 'false'
ENV['RCT_USE_PREBUILT_RNCORE'] ||= '1' if podfile_properties['ios.buildReactNativeFromSource'] != 'true' && podfile_properties['newArchEnabled'] != 'false'
platform :ios, podfile_properties['ios.deploymentTarget'] || '16.4'

prepare_react_native_project!

verify_ccache_installed(podfile_properties)

target 'KRANA' do
  use_expo_modules!

  # Google Sign-In → AppCheckCore (Swift) needs module maps on these ObjC deps.
  pod 'GoogleUtilities', :modular_headers => true
  pod 'RecaptchaInterop', :modular_headers => true

  if ENV['EXPO_USE_COMMUNITY_AUTOLINKING'] == '1'
    config_command = ['node', '-e', "process.argv=['', '', 'config'];require('@react-native-community/cli').run()"];
  else
    config_command = [
      'node',
      '--no-warnings',
      '--eval',
      'require(\'expo/bin/autolinking\')',
      'expo-modules-autolinking',
      'react-native-config',
      '--json',
      '--platform',
      'ios'
    ]
  end

  config = use_native_modules!(config_command)

  # Ensures native RNCViewPager is linked (HomeTabPager). Autolinking sometimes omits this pod in Expo+iOS setups.
  pod 'react-native-pager-view', :path => '../node_modules/react-native-pager-view'

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => podfile_properties['expo.jsEngine'] == nil || podfile_properties['expo.jsEngine'] == 'hermes',
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :privacy_file_aggregation_enabled => podfile_properties['apple.privacyManifestAggregationEnabled'] != 'false',
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      :ccache_enabled => ccache_enabled?(podfile_properties),
    )

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        current_deployment_target = build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        if current_deployment_target && Gem::Version.new(current_deployment_target) < Gem::Version.new('12.0')
          build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '12.0'
        end

        build_config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
        build_config.build_settings['SWIFT_SUPPRESS_WARNINGS'] = 'YES'
        build_config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        header_paths = build_config.build_settings['HEADER_SEARCH_PATHS'] || ['$(inherited)']
        header_paths = [header_paths] if header_paths.is_a?(String)
        header_paths += [
          '$(PODS_ROOT)/Headers/Public',
          '$(PODS_ROOT)/Headers/Public/glog',
          '$(PODS_ROOT)/Headers/Public/RCT-Folly',
          '$(PODS_ROOT)/glog/src',
        ]
        build_config.build_settings['HEADER_SEARCH_PATHS'] = header_paths.uniq

        # react-native-health uses deprecated HealthKit API (dateOfBirth, deprecated iOS 10).
        # Suppress -Wdeprecated-declarations for this pod to prevent build failure.
        if target.name == 'RNAppleHealthKit'
          flags = build_config.build_settings['OTHER_CFLAGS'] || ['$(inherited)']
          flags = [flags] if flags.is_a?(String)
          flags += [
            '-Wno-deprecated-declarations',
            '-Wno-shorten-64-to-32',
            '-Wno-incompatible-pointer-types',
            '-Wno-format-security',
            '-Wno-unused-variable',
            '-Wno-incomplete-implementation',
            '-Wno-protocol',
          ]
          build_config.build_settings['OTHER_CFLAGS'] = flags.uniq
        end

        if target.name == 'GoogleSignIn'
          flags = build_config.build_settings['OTHER_CFLAGS'] || ['$(inherited)']
          flags = [flags] if flags.is_a?(String)
          flags += ['-Wno-deprecated-declarations']
          build_config.build_settings['OTHER_CFLAGS'] = flags.uniq
        end

        # Xcode 26 / Swift 6: expo-modules-jsi uses weak runtime refs on Sendable types.
        if target.name == 'ExpoModulesJSI'
          build_config.build_settings['SWIFT_STRICT_CONCURRENCY'] = 'minimal'
        end

        if target.name == 'RCT-Folly'
          defs = build_config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] || ['$(inherited)']
          defs = [defs] if defs.is_a?(String)
          defs += ['FOLLY_HAVE_ELF=0', 'FOLLY_HAVE_DWARF=0']
          build_config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = defs.uniq

          folly_headers = build_config.build_settings['HEADER_SEARCH_PATHS'] || ['$(inherited)']
          folly_headers = [folly_headers] if folly_headers.is_a?(String)
          folly_headers += ["#{Pod::Config.instance.installation_root}/compat"]
          build_config.build_settings['HEADER_SEARCH_PATHS'] = folly_headers.uniq
        end
      end

      target.shell_script_build_phases.each do |phase|
        next unless [
          '[CP-User] Generate updates resources for expo-updates',
          '[CP-User] react-native-maps patches',
          '[CP-User] [Hermes] Replace Hermes for the right configuration, if needed'
        ].include?(phase.name)

        phase.always_out_of_date = '1' if phase.respond_to?(:always_out_of_date=)
      end
    end

    # Xcode 26 exposes a demangle header variant that breaks RCT-Folly.
    # Force-disable the libiberty demangle branch after pod generation.
    demangle_file = File.join(installer.sandbox.root.to_s, 'RCT-Folly', 'folly', 'Demangle.cpp')
    if File.exist?(demangle_file)
      begin
        File.chmod(0o644, demangle_file)
      rescue
      end
      content = File.read(demangle_file)
      patched = content.gsub('#if __has_include(<demangle.h>)', '#if 0')
      if patched != content
        File.open(demangle_file, 'w') { |f| f.write(patched) }
      end
    end

    # Hermes: custom flags for release builds — менший і швидший байткод
    installer.pods_project.targets.each do |target|
      if target.name == 'hermes-engine'
        target.build_configurations.each do |config|
          if config.name == 'Release'
            # -w: suppress Hermes compiler warnings from generated code
            config.build_settings['HERMES_FLAGS'] = '-O -output-source-map -w'
          end
        end
      end
    end

    # Пришвидшення збірки: паралельна компіляція для всіх pod-ів
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['GCC_OPTIMIZATION_LEVEL'] = 's' if config.name == 'Release'
      end
    end
  end
end
