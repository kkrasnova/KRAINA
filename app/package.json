{
  "name": "kraina-app",
  "version": "1.0.1",
  "main": "index.js",
  "expo": {},
  "scripts": {
    "start:expo": "CI=1 bash ./scripts/with-node20.sh npx expo start --tunnel",
    "start:expo:alt": "CI=1 bash ./scripts/with-node20.sh npx expo start --tunnel --port 8082 --non-interactive",
    "start:expo:ui": "bash ./scripts/with-node20.sh npx expo start --lan",
    "postinstall": "patch-package && node scripts/patch-metro-merge-config.js",
    "patch:metro": "node scripts/patch-metro-merge-config.js",
    "install:app": "npm install",
    "rn": "bash ./scripts/with-node20.sh npx react-native",
    "start": "bash ./scripts/with-node20.sh npx react-native start --host 0.0.0.0",
    "start:clear": "bash ./scripts/start-metro-force.sh",
    "start:force": "bash ./scripts/start-metro-force.sh",
    "start:go": "bash ./scripts/with-node20.sh npx react-native start --host 0.0.0.0 --reset-cache",
    "start:ios": "bash ./scripts/with-node20.sh npx react-native start --host 0.0.0.0 --reset-cache",
    "start:ios-only": "bash ./scripts/with-node20.sh npx react-native start --host 0.0.0.0 --reset-cache",
    "android": "bash ./scripts/with-node20.sh npx react-native run-android",
    "android:dev": "bash ./scripts/android-dev.sh",
    "android:build": "bash ./scripts/with-node20.sh bash ./android-build.sh",
    "ios": "bash ./scripts/with-node20.sh npx react-native run-ios",
    "ios:dev": "bash ./scripts/ios-dev.sh",
    "ios:build": "bash ./scripts/with-node20.sh bash ./ios-build.sh",
    "ios:prebuild": "echo \"Using native iOS project (no Expo prebuild).\"",
    "ios:pod": "cd ios && pod install",
    "google:ios-scheme": "node scripts/apply-google-ios-scheme.js",
    "check:oauth": "node scripts/check-oauth-config.js",
    "web": "echo \"Web build is disabled in native mode.\"",
    "clean": "bash ./scripts/clean-rebuild.sh",
    "clean:soft": "bash ./scripts/clean-rebuild.sh --soft",
    "clean:start": "bash ./scripts/clean-rebuild.sh --start",
    "clean:full": "bash ./scripts/clean-rebuild.sh",
    "update": "bash ./scripts/with-node20.sh eas update --channel development --message",
    "update:preview": "bash ./scripts/with-node20.sh eas update --channel preview --message",
    "update:production": "bash ./scripts/with-node20.sh eas update --channel production --message"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.13.0",
    "axios": "^1.15.0",
    "events": "^3.3.0",
    "expo": "~56.0.11",
    "expo-apple-authentication": "~56.0.4",
    "expo-asset": "~56.0.17",
    "expo-audio": "~56.0.12",
    "expo-auth-session": "~56.0.14",
    "expo-blur": "^56.0.3",
    "expo-camera": "~56.0.8",
    "expo-crypto": "~56.0.4",
    "expo-file-system": "~56.0.7",
    "expo-font": "~56.0.6",
    "expo-image": "~56.0.11",
    "expo-image-picker": "~56.0.17",
    "expo-linear-gradient": "~56.0.4",
    "expo-location": "~56.0.17",
    "expo-media-library": "~56.0.7",
    "expo-network": "~56.0.5",
    "expo-notifications": "~56.0.17",
    "expo-secure-store": "~56.0.4",
    "expo-speech": "~56.0.3",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-updates": "~56.0.19",
    "expo-video": "~56.1.3",
    "expo-web-browser": "~56.0.5",
    "firebase": "^11.0.2",
    "js-sha256": "^0.11.1",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-chart-kit": "^6.12.0",
    "react-native-health": "^1.19.0",
    "react-native-health-connect": "^3.5.0",
    "react-native-iap": "^14.4.46",
    "react-native-maps": "1.27.2",
    "react-native-nitro-modules": "^0.35.0",
    "react-native-pager-view": "8.0.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "zustand": "^5.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=20.19.4"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@react-native-community/cli": "^20.1.2",
    "@react-native/metro-config": "0.85.3",
    "@types/react": "~19.2.14",
    "babel-preset-expo": "~56.0.0",
    "dotenv": "^17.4.0",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  }
}
